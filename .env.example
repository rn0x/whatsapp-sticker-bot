# ==== WhatsApp Sticker Bot — Environment Template ====
# انسخ إلى .env وعدّل القيم. كل المفاتيح اختيارية ولها قيم افتراضية داخل التطبيق.

# --- App ---
# APP_DATA_DIR: مكان تخزين البيانات (قاعدة البيانات، الملفات المؤقتة، النسخ الاحتياطية).
# افتراضياً: <مجلد بيانات التطبيق في Electron>
# APP_DATA_DIR=/home/user/.whatsapp-sticker-bot

# --- Security ---
# كلمة مرور لوحة التحكم (أو تُضبط أول مرة من الواجهة نفسها).
# إذا تُركت فارغة، يُطلب إنشاؤها عند أول تشغيل للوحة.
# ADMIN_PASSWORD=

# قفل اللوحة تلقائياً بعد خمول (بالدقائق). صفر = لا قفل.
# LOCK_TIMEOUT_MINUTES=10

# --- Bot / Quota ---
# DEFAULT_DAILY_QUOTA=50
# QUOTA_MODE=rolling_24h        # rolling_24h | daily_fixed | unlimited

# --- Queue / Workers ---
# MAX_MEDIA_WORKERS=4           # عدد عمليات FFmpeg/Sharp المتزامنة
# MAX_DOWNLOAD_WORKERS=2
# MAX_QUEUE_SIZE=100000
# MAX_PENDING_JOBS_PER_USER=50
# JOB_LEASE_TIMEOUT_MS=600000   # 10 دقائق
# JOB_HEARTBEAT_INTERVAL_MS=30000
# MAX_RETRIES=5

# --- Media Limits ---
# MAX_IMAGE_BYTES=200MB
# MAX_VIDEO_BYTES=64MB
# MAX_VIDEO_DURATION_SECONDS=30
# STICKER_MAX_FPS=30
# STICKER_QUALITY=90

# --- Storage ---
# CACHE_RETENTION_HOURS=6
# FAILED_RETENTION_DAYS=7
# LOGS_RETENTION_DAYS=30
# DISK_FREE_SPACE_THRESHOLD_MB=2000   # إيقاف استقبال Media تحته

# --- WhatsApp ---
# BOT_NAME=Sticker Bot
# STICKER_PACK=Sticker Bot
# STICKER_AUTHOR=Sticker Bot
# GROUP_MODE=mention_only        # off | mention_only | command_only | auto
# AUTO_RECONNECT=true

# --- Bridge ---
# VITE_DEV_SERVER_URL set automatically in development