---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import DownloadButtons from "../../components/DownloadButtons.astro";
import Features from "../../components/Features.astro";
import Platforms from "../../components/Platforms.astro";
import Screenshots from "../../components/Screenshots.astro";
import FAQ from "../../components/FAQ.astro";
import { getRelease } from "../../lib/release";
import { t } from "../../i18n/ui";

const lang = "en";
const ui = t(lang);
const release = await getRelease();
---
<BaseLayout lang="en" dir="ltr" title={ui.metaTitle} description={ui.metaDescription} pathname="en/" ui={ui} release={release}>
  <Hero ui={ui} />
  <DownloadButtons ui={ui} assets={release.assets} />
  <Features ui={ui} />
  <Platforms ui={ui} />
  <Screenshots ui={ui} />
  <FAQ ui={ui} />
</BaseLayout>
