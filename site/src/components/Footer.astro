---
import type { UiDict } from "../i18n/ui";
import type { ReleaseInfo } from "../lib/release";
const { ui, release, base } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <div style="font-weight:800;font-size:16px;">WhatsApp Sticker Bot</div>
      <div class="muted">{ui.footer.madeBy} Rayan Almalki · {ui.footer.rights} {new Date().getFullYear()}</div>
    </div>
    <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
      <a href="https://github.com/rn0x/whatsapp-sticker-bot" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/rn0x/whatsapp-sticker-bot/releases" target="_blank" rel="noopener">{ui.nav.download}</a>
      <a href={`${base}favicon.svg`} rel="license">{ui.footer.license}</a>
      <span class="muted">{ui.footer.version} <span id="site-version">{release.version}</span></span>
    </div>
  </div>
</footer>
